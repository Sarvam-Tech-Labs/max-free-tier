# Optional, for direnv users. gh CLI inside this repo is pinned to HowardZlh via `git config gh.configDir`
# (see ~/.zshenv wrapper). New machine: re-run the three steps from the gh-account-isolation skill:
#   git config --local gh.configDir '~/.config/gh-howardzlh'
#   git remote set-url origin https://HowardZlh@github.com/HowardZlh/usage-guard-collector.git
#   git config --local credential.helper '' && git config --local --add credential.helper '!GH_CONFIG_DIR=$HOME/.config/gh-howardzlh gh auth git-credential'
export GH_CONFIG_DIR="$HOME/.config/gh-howardzlh"
